# Required: Anthropic API key
# Get yours at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Optional: enables web search for the Competitive Cartographer and Discovery Strategist agents.
# Anthropic's web_search tool is included with the API by default — no extra key needed —
# but if your account requires a feature flag, set this to "true".
ENABLE_WEB_SEARCH=true
